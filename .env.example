# من لوحة Supabase الخاصة بأخيك: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# سري جدًا: لا يبدأ بـ NEXT_PUBLIC ولا يُرفع للمتصفح. يُستخدم فقط في صفحة إدارة الحسابات
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# النطاق الوهمي الذي يحوّل اسم المستخدم إلى بريد داخلي (لا يُرسل إليه شيء)
NEXT_PUBLIC_AUTH_DOMAIN=habits.example.com
